enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

model Invoice {
  id         String  @id @default(uuid()) @db.Uuid
  number     String  @unique
  clinicId   String? @db.Uuid
  locationId String? @db.Uuid
  patientId  String  @db.Uuid

  appointmentId   String? @db.Uuid
  labOrderId      String? @db.Uuid
  pharmacyOrderId String? @db.Uuid

  status InvoiceStatus @default(DRAFT)

  subtotal    Decimal @db.Decimal(12, 2) @default(0)
  discount    Decimal @db.Decimal(12, 2) @default(0)
  taxAmount   Decimal @db.Decimal(12, 2) @default(0)
  total       Decimal @db.Decimal(12, 2) @default(0)
  amountPaid  Decimal @db.Decimal(12, 2) @default(0)
  currency    String  @default("INR")

  notes    String?
  pdfKey   String?
  issuedAt DateTime?
  dueAt    DateTime?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient       Patient        @relation(fields: [patientId], references: [id])
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  labOrder      LabOrder?      @relation(fields: [labOrderId], references: [id])
  pharmacyOrder PharmacyOrder? @relation(fields: [pharmacyOrderId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@index([clinicId, status, createdAt])
  @@index([patientId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(10, 2) @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2) @default(0)
  taxRate     Decimal @db.Decimal(5, 2)  @default(0)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  PAYMENT_LINK
  QR
  CASH
  MANUAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  clinicId String? @db.Uuid
  patientId String @db.Uuid
  invoiceId String? @db.Uuid
  appointmentId String? @db.Uuid

  method   PaymentMethod
  status   PaymentStatus @default(PENDING)
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("INR")

  provider        String?
  providerOrderId String?
  providerPaymentId String? @unique
  /** Guarantees a retried client call never creates a second charge. */
  idempotencyKey  String  @unique

  capturedAt DateTime?
  failedAt   DateTime?
  failureReason String?

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([clinicId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([providerOrderId])
  @@map("payments")
}

model PaymentTransaction {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  event     String
  provider  String?
  /** Provider event id, used to reject webhook replays. */
  providerEventId String? @unique
  payload   Json?
  signatureVerified Boolean @default(false)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

model Refund {
  id        String       @id @default(uuid()) @db.Uuid
  paymentId String       @db.Uuid
  amount    Decimal      @db.Decimal(12, 2)
  reason    String
  status    RefundStatus @default(REQUESTED)

  provider         String?
  providerRefundId String?  @unique
  idempotencyKey   String   @unique

  requestedById String?   @db.Uuid
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

model ExpenseCategory {
  id       String  @id @default(uuid()) @db.Uuid
  clinicId String? @db.Uuid
  key      String
  name     String
  isSystem Boolean @default(false)

  expenses Expense[]

  @@unique([clinicId, key])
  @@map("expense_categories")
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id         String @id @default(uuid()) @db.Uuid
  clinicId   String @db.Uuid
  locationId String? @db.Uuid
  categoryId String @db.Uuid

  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  vendor      String?
  description String?
  attachmentKey String?
  status      ExpenseStatus @default(DRAFT)

  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([clinicId, date])
  @@index([status])
  @@map("expenses")
}
