{
  "name": "@cliniqx/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo no-lint",
    "build": "prisma generate && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "@cliniqx/config": "workspace:*",
    "@cliniqx/shared": "workspace:*",
    "@faker-js/faker": "^9.4.0",
    "@types/node": "^22.20.4",
    "argon2": "^0.41.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ]
}