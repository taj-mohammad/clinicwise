# ---- Core ----
NODE_ENV=development
APP_NAME=CliniqX
API_PORT=4100
WEB_PORT=3000
API_URL=http://localhost:4100
WEB_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://cliniqx:cliniqx_dev_password@localhost:5433/cliniqx?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6380

# ---- Auth ----
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=localhost
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Storage (S3 compatible) ----
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=cliniqx-medical
S3_ACCESS_KEY=cliniqx
S3_SECRET_KEY=cliniqx_dev_password
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# ---- Payments (abstraction; leave blank to disable) ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WhatsApp (abstraction; leave blank to disable) ----
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ---- AI (optional) ----
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
LOCAL_STORAGE_PATH=./storage
